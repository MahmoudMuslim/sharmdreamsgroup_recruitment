# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev server / build output
server.log
build.log

# env files (can opt-in for committing if needed)
.env*
# …and this is the opt-in. The template holds placeholders only, README and
# docs/DEPLOYMENT.md both point a new deploy at it, and `scripts/audit-secrets.mjs`
# reads it as a deploy-surface file — none of which works on a fresh clone while
# `.env*` above swallows it. `docker/.env.example` has always had this exception;
# the root one did not.
!.env.example

# Prompt/notes files can contain pasted credentials — never track them.
# A glob because `prompt2.md` slipped past the two literal names this used to
# list: it carried the retired vendor project's host, and it was in the repo.
prompt*.md
PROMPT*.md

# Root-level PDFs are somebody's document (a real CV was committed here), not
# source. Assets the app serves belong in public/.
/*.pdf
# …but public/ is copied into the app image and served by nginx, so a personal
# document must not land there either. Stored candidate files live in the
# `uploads` volume, which no build context reads.
/public/*.pdf

# history-rewrite and installer leftovers that were both committed once
/bfg*.jar

# typescript
*.tsbuildinfo
next-env.d.ts

# Local self-host stack: PII dumps and real secrets never enter the repo.
docker/data/*
!docker/data/.gitkeep
docker/.env
!docker/.env.example
# The host-side twin of the container's /data/uploads volume. Same rule: these
# are candidate CVs and pitch recordings, and a `git add .` must never see them.
.data/
