# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev server / build output
server.log
build.log

# env files (can opt-in for committing if needed)
.env*

# Prompt/notes files can contain pasted credentials — never track them.
prompt.md
PROMPT.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local self-host stack: PII dumps and real secrets never enter the repo.
docker/data/*
!docker/data/.gitkeep
docker/.env
!docker/.env.example
# The host-side twin of the container's /data/uploads volume. Same rule: these
# are candidate CVs and pitch recordings, and a `git add .` must never see them.
.data/
