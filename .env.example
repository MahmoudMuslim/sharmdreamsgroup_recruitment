# ============================================================================
# Sharm Dreams Group — HRMS / ATS / Skill Assessment Platform
# Environment Configuration Template
# ============================================================================
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control!
# ============================================================================

# ---------------------------------------------------------------------------
# Our own PostgREST (the local Docker stack: db + rest + gateway)
# Every row read and write goes here. Start the stack with `npm run docker:up`,
# then `npm run stack:prove`. A trailing slash is harmless; the transport strips
# it. The host form points at the Caddy gateway on 54321 with the /rest/v1
# prefix; a container on the compose network uses http://rest:3000 with no
# prefix, and docker-compose.yml sets that itself.
#
# There is no vendor block here any more. The four `NEXT_PUBLIC_SUPABASE_*` /
# `SUPABASE_SERVICE_ROLE_KEY` / `SUPABASE_DB_PASSWORD` names are read by nothing
# in `src`, the image build takes no build args, and the bytes live on our own
# `uploads` volume. The hosted-project scripts that used to read them out of the
# owner's `.env.local` are deleted, so an entry naming one here would set a value
# no code reads — and `npm run audit:secrets` fails the build if one appears.
# docs/DEPLOYMENT.md lists what the app actually requires.
# ---------------------------------------------------------------------------
REST_BASE_URL=http://localhost:54321/rest/v1

# ---------------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000

# Encryption key for storing API credentials (generate with: node scripts/generate-encryption-key.mjs)
SETTINGS_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# ---------------------------------------------------------------------------
# AI Model Providers (Keys stored in Settings → API keys panel, fallback to env)
# ---------------------------------------------------------------------------
# OpenRouter - Unified API for 100+ LLMs
OPENROUTER_API_KEY=your_openrouter_key_here

# Google AI Studio - Gemini models
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here

# OpenCode - OpenAI-compatible inference gateway (paid models for server use)
OPENCODE_API_KEY=your_opencode_key_here

# Qoder - Cloud Agents API personal access token (prefix pt-)
QODER_API_KEY=your_qoder_pat_here

# Cloudflare Workers AI - OpenAI-compatible inference on Cloudflare's network.
# Both are required: every Workers AI call is addressed to an account. The token
# must be scoped to Workers AI, not the account's global API key.
# Free allowance is 10,000 neurons a day.
CLOUDFLARE_AI_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_AI_ACCOUNT_ID=your_cloudflare_account_id_here

# NVIDIA NIM - 80+ open models behind one OpenAI-compatible endpoint.
# A free key needs phone verification and no card; roughly 40 requests a minute.
NVIDIA_API_KEY=your_nvidia_key_here


# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta)
# Configure in Settings → API keys panel for multi-key support
# ---------------------------------------------------------------------------
# Only the three the runtime actually reads. There is no inbound webhook route in
# this app — Meta pushes nothing here, the queue drains outward on a cron poll — so
# no `WHATSAPP_WEBHOOK_URL` and no `WHATSAPP_APP_SECRET` (signature verification)
# belongs in this template.
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# ---------------------------------------------------------------------------
# Email (Optional - for notifications)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM=noreply@your-domain.com