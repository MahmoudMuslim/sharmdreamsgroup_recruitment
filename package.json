{
  "name": "sharm_dreams_group",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file docker/.env up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file docker/.env down",
    "docker:wipe": "docker compose -f docker/docker-compose.yml --env-file docker/.env down -v",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file docker/.env logs -f",
    "docker:psql": "docker compose -f docker/docker-compose.yml --env-file docker/.env exec db psql -U postgres -d sharm_dreams",
    "db:apply-local": "node scripts/apply-local-schema.mjs",
    "db:seed-local": "node scripts/seed-local-staff.mjs",
    "prebuild": "node scripts/check-staff-routes.mjs && node scripts/check-themes.mjs",
    "build": "next build",
    "check:routes": "node scripts/check-staff-routes.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@glinui/ui": "^0.1.1",
    "@handsontable/react": "^16.2.0",
    "@qoder-ai/qoder-agent-sdk": "^1.0.52",
    "@supabase/server": "^1.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@thelioo/opencode-balancer": "^0.2.18",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.143",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.1.0",
    "handsontable": "^16.2.0",
    "hyperformula": "^3.5.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
