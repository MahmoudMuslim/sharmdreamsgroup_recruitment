# Copy to docker/.env (git-ignored) and change nothing for local dev.
# These are LOCAL DEV values. On KVM2 every one of these is replaced from a
# secrets file that never enters the repo.

# Postgres superuser password for the local cluster.
LOCAL_DB_PASSWORD=sdg_local_dev_pw

# Password for the PostgREST login role. Must match docker/db/initdb/00-roles.sql.
LOCAL_PGRST_PASSWORD=sdg_pgrst_local

# HS256 secret for tokens the app mints. PostgREST and src/lib/auth/token.ts
# read the same value, so they can never disagree about who is signed in.
AUTH_JWT_SECRET=replace-with-48-random-chars-local-only

# Host ports. 54320/54321 are chosen so nothing collides with the owner's dev
# server on 3001 or a locally-installed Postgres on 5432.
LOCAL_DB_PORT=54320
LOCAL_GATEWAY_PORT=54321

# Local-only password for the seeded staff fixtures. Never reuse anywhere real.
LOCAL_STAFF_PASSWORD=sdg-local-fixture-pw

# Authoring note: this value is a URI on purpose. It is read verbatim by
# new Pool({ connectionString: ... }) and never built by interpolating a
# password, so the only risk is whoever types it: if you rotate
# LOCAL_DB_PASSWORD, percent-encode it here too (@ -> %40, / -> %2F,
# % -> %25), because pg parses this string with the RFC 3986 userinfo
# grammar and an unencoded @ makes it look for the host in the middle of
# your password.
# The app's own connection string for auth work only (password verification,
# and later the staff directory). PostgREST never sees it.
AUTH_DB_URL=postgresql://postgres:sdg_local_dev_pw@localhost:54320/sharm_dreams

# --- Task 16: the cron container -------------------------------------------
# Shared secret between the app and docker/cron. The two route handlers compare
# it against the `x-cron-secret` header and answer 401 when it does not match,
# 503 when the APP has none. Leave it empty here and the container says so in
# `docker compose logs cron` and sleeps instead of spamming failures.
# Generate locally: openssl rand -hex 32. Never put a real value in this file —
# it is committed; the real one lives only in the git-ignored docker/.env.
CRON_SECRET=

# How often the container knocks, in seconds. Both routes are idempotent
# sweeps, so a short interval costs one query and a long one delays a
# candidate's notice.
#
# RATIO, not two independent numbers: the grading sweep runs every
# GRADING_EVERY / WHATSAPP_EVERY ticks, and that division is integer division —
# 300 / 60 = 5, so grading rides every fifth tick. Change one interval and you
# must change the other, or the ratio truncates (run.sh clamps it to >= 1, so
# the worst case is grading on every tick, not a modulo-by-zero each tick).
WHATSAPP_EVERY=60
GRADING_EVERY=300

# Where the cron container finds the app. Unset or empty = the compose default
# http://app:3000, the app container on the compose network. Set it to
# http://host.docker.internal:3000 to point the poller at a host-side
# `next dev` instead.
# APP_URL=http://app:3000

# Batch sizes read by the APP (src/lib/config.server.ts `cronConfig`), not by
# the container: rows the WhatsApp sweep drains per call, attempts the grading
# sweep revisits per call. Never leave either empty: the compose `:-` guard only
# covers a variable this file does not set at all, while the app's own
# `Number(process.env.X ?? 50)` does not fire on "" and turns it into 0.
WHATSAPP_CRON_BATCH_SIZE=50
GRADING_CRON_BATCH_SIZE=10

# --- The containerized app and its nginx front ------------------------------
# Host port nginx publishes. Loopback only, and 3000 because that is the port
# this migration was agreed on — the owner's own dev server stays on 3001 and
# must never be taken.
NGINX_PORT=3000

# The address assessment links and email copy are built from
# (src/lib/config.ts:57). localhost is right for a browser on this machine and
# wrong for a candidate on a phone: set it to the LAN address, e.g.
# http://192.168.1.6:3000, before sending a link to anyone else's device.
# APP_URL_PUBLIC=http://localhost:3000

# BUILD args, not runtime env: Next inlines NEXT_PUBLIC_* into the client bundle
# while the image builds, so a value that only exists in the container's
# environment never reaches it. These two are the copy of the same names in the
# root .env.local — .dockerignore excludes .env.local from the build context so
# that the rest of it (service-role key, SMTP, WhatsApp, every AI provider key)
# cannot be baked into an image layer. File bytes still travel to the vendor
# through the first of these until Plan 2 replaces src/lib/files/store.ts.
# Both are already public by design: the URL ships to every browser, and the
# anon key authorises the tokenless role that RLS confines.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

