# ============================================================================
# KVM2 / PRODUCTION — App runtime environment  (-> root .env.local)
# ============================================================================
# Copy on the VPS:   cp deploy/kvm2/env.local .env.local
#
# Loaded by the app container through `env_file: ../.env.local`. The compose
# `environment:` block OVERRIDES the in-network forms of REST_BASE_URL,
# AUTH_DB_URL, AUTH_JWT_SECRET, AUTH_TOKEN_*, CRON_SECRET and UPLOADS_ROOT, so
# those do NOT belong here for the container. This file carries only the values
# the container gets from nowhere else: the public URL, the encryption key, and
# the third-party integration secrets.
#
# AI keys here are FALLBACKS. Settings → API keys stores them AES-256-GCM
# encrypted and WINS over these. Preferred: leave the keys blank and paste them
# into Settings after first sign-in.
# ============================================================================

# --- Canonical public URL -----------------------------------------------------
# Used for candidate-facing links and cookie `Secure` decisions.
APP_URL=https://sharmdreamsgroup.cloud
NEXT_PUBLIC_APP_URL=https://sharmdreamsgroup.cloud

# --- Credentials encryption ---------------------------------------------------
# AES-256-GCM key for stored provider/WhatsApp/SMTP secrets. MUST be >= 32 chars.
# Generate:   node scripts/generate-encryption-key.mjs
SETTINGS_ENCRYPTION_KEY=

# --- AI providers (optional — env fallback only) ------------------------------
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
OPENCODE_API_KEY=
QODER_API_KEY=
# QODER_ACCESS_TOKEN replaces QODER_API_KEY for the agent-SDK worker directory.
# QODER_ACCESS_TOKEN=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_ACCOUNT_ID=
NVIDIA_API_KEY=

# --- Email (SMTP notifications) ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- WhatsApp outbound --------------------------------------------------------
# Outbound dispatch (/api/cron/whatsapp) + verification token. There is NO
# inbound webhook route in this build, so there is no WHATSAPP_WEBHOOK_URL here.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- NOT IMPLEMENTED YET — leave these unset ----------------------------------
# Google / Microsoft Calendar OAuth and Frappe HR / ATS sync are still in-progress
# (no consent flow, no adapter). Adding keys for them today changes nothing:
#   GOOGLE_CALENDAR_CLIENT_ID / _SECRET / _REDIRECT_URI
#   MS_CALENDAR_CLIENT_ID / _SECRET / _REDIRECT_URI
#   FRAPPE_HR_API_KEY / _API_SECRET / _BASE_URL
