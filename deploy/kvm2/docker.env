# ============================================================================
# KVM2 / PRODUCTION — Compose environment  (-> docker/.env)
# ============================================================================
# Copy on the VPS:   cp deploy/kvm2/docker.env docker/.env
#
# Read by:  docker compose -f docker/docker-compose.yml --env-file docker/.env
# It is for the STACK ONLY (db / rest / app / nginx / cron). It is NOT the
# app's runtime env — the app container loads the root `.env.local` too.
#
# Placeholders below are SHAPED but EMPTY on purpose. Generate each one with the
# command shown; never reuse the local dev values, and never commit a filled copy.
# ============================================================================

# --- Database -----------------------------------------------------------------
# Postgres superuser password.   Generate: openssl rand -hex 16
LOCAL_DB_PASSWORD=

# PostgREST `authenticator` login password.   Generate: openssl rand -hex 16
# NOTE: env-authoritative only on a FRESH volume. Rotating it later requires
# `npm run docker:wipe` first (see docs/DEPLOYMENT.md). Its literal inside
# docker/db/initdb/00-roles.sql is ignored while this is set.
LOCAL_PGRST_PASSWORD=

# --- Session signing ----------------------------------------------------------
# HS256 secret the app mints AND PostgREST verifies (one value for both).
# MUST be >= 32 chars.   Generate: openssl rand -hex 32
AUTH_JWT_SECRET=

# Token environment names. SET THESE BEFORE THE FIRST USER SIGNS IN.
# Changing AUTH_TOKEN_AUDIENCE later signs out every session at once.
AUTH_TOKEN_ISSUER=sharm-dreams-prod
AUTH_TOKEN_AUDIENCE=sdg_prod

# --- Host ports (loopback only) ----------------------------------------------
# Nothing here is LAN-routable. On KVM2 the public front is TLS on 80/443
# (see the note at the bottom), NOT these mappings.
LOCAL_DB_PORT=54320
LOCAL_GATEWAY_PORT=54321

# --- First staff logins -------------------------------------------------------
# db/initdb/04-seed-staff.sh creates three sign-ins on the FIRST boot of the
# `db-data` volume: this owner (SUPER_ADMIN), plus RECRUITER and CANDIDATE
# fixtures for testing. Empty skips the seed - there is no default password.
# Change it after the first sign-in.   Generate: openssl rand -hex 12
LOCAL_STAFF_PASSWORD=

# The SUPER_ADMIN login handle. It is only an identifier - nothing is emailed to
# it - but use an address you own, because a `.test` admin on a public host is
# the first thing a reviewer reports.
STAFF_OWNER_EMAIL=admin@sharmdreamsgroup.cloud
STAFF_OWNER_NAME=Group Owner

# --- Cron ---------------------------------------------------------------------
# Shared secret for /api/cron/{whatsapp,grading} (x-cron-secret header).
# Both routes fail closed (503) while this is empty.   Generate: openssl rand -hex 32
CRON_SECRET=

# Poll cadence (seconds). Keep GRADING_EVERY / WHATSAPP_EVERY a whole ratio
# (300 / 60 = 5 => grading rides every 5th tick).
WHATSAPP_EVERY=60
GRADING_EVERY=300

# Batch sizes read by the APP, not the cron container. Never leave blank.
WHATSAPP_CRON_BATCH_SIZE=50
GRADING_CRON_BATCH_SIZE=10

# --- Front door ---------------------------------------------------------------
# nginx publishes on loopback; the KVM2 override (docker-compose.kvm2.yml) adds
# one public TLS listener in front of it.
NGINX_PORT=3000

# Public TLS front door (Caddy `front` in docker-compose.kvm2.yml).
# DNS: <SDG_DOMAIN> A/AAAA must point at this server; firewall must allow 80+443.
SDG_DOMAIN=sharmdreamsgroup.cloud
# Let's Encrypt registration / expiry notices.
ACME_EMAIL=admin@sharmdreamsgroup.cloud

# The address candidate assessment links + email copy are built from.
# MUST be your real public HTTPS origin or candidates receive broken links.
APP_URL_PUBLIC=https://sharmdreamsgroup.cloud

# Force Secure cookies behind TLS. Leave as `true` on production.
COOKIE_SECURE=true

# --- Stored bytes -------------------------------------------------------------
# The `uploads` named volume mount inside the app container. Leave as-is unless
# you deliberately move the tree. This directory holds candidate PII.
UPLOADS_ROOT=/data/uploads

# --- NOT set here -------------------------------------------------------------
# AUTH_DB_URL  : compose injects the in-network form (postgres://...@db:5432/...)
#                into the app; do not set the host form here (an unencoded `@`
#                in a password breaks the RFC 3986 userinfo parse).
# REST_BASE_URL: compose injects http://rest:3000 for the app container.

# ============================================================================
# KVM2 TLS is handled INSIDE the stack: run with the override so Caddy owns
# 80/443 and auto-issues the certificate.
#
#   npm run docker:up:kvm2
#   # == docker compose -f docker/docker-compose.yml \
#   #      -f docker/docker-compose.kvm2.yml --env-file docker/.env up -d
#
# That single command is the whole first deploy. On a fresh `db-data` volume the
# db image applies db/schema.sql (46 tables, 99 policies, 9 companies + lookups)
# and then seeds the three staff logins above, so the stack is signable-in when
# `up` returns - no `db:apply-local`, no `db:seed-local`, no pass of a SQL file
# by hand. Check the log lines `[initdb] ...` in `docker compose logs db` if you
# want to see each step confirm itself.
#
# The base stack still speaks plain HTTP on loopback; only `front` is public.
# ============================================================================
